{
  "name": "@photon-ai/flux",
  "version": "0.6.6",
  "description": "Flux CLI - Connect LangChain agents to iMessage",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "flux": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "flux": "bun src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.4",
    "better-grpc": "^0.3.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.0"
  }
}
